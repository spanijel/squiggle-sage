{
  "manifest_version": 3,
  "name": "SquiggleSage",
  "short_name": "SquiggleSage",
  "version": "0.2.3",
  "description": "Local spelling and English writing suggestions for the Firefox browser. No text is sent to a server.",
  "incognito": "not_allowed",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "background": {
    "scripts": [
      "src/vendor/typo-js/typo.js",
      "src/core/spelling.js",
      "src/background/background.js"
    ]
  },
  "action": {
    "default_title": "SquiggleSage",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "64": "assets/icon-64.png",
      "96": "assets/icon-96.png",
      "128": "assets/icon-128.png"
    },
    "default_popup": "src/ui/popup.html"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "64": "assets/icon-64.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": [
        "src/shared/defaults.js",
        "src/core/checker.js",
        "src/core/spelling.js",
        "src/content/highlighter.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/content.css"
      ]
    }
  ],
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "squiggle-sage@spanijel.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
